<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart-X</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        main {
            flex: 1;
        }

        .navbar {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            background: linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        footer {
            background-color: #212529;
            color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
            padding: 2rem 0;
        }

        .alert {
            border: none;
            border-radius: 0.5rem;
        }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-hdd"></i> Smart-X Gateway
            </a>
            <span class="navbar-text text-white small">
                IoT Telemetry & Configuration Platform
            </span>
        </div>
    </nav>

    <main class="py-3">
        @RenderBody()
    </main>

    <footer>
        <div class="container-fluid text-center">
            <p class="mb-1">&copy; 2026 Smart-X IoT Platform. Resource-optimized for edge computing.</p>
            <small class="text-muted">Powered by .NET 9 &bull; Razor Pages &bull; Minimal APIs</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>